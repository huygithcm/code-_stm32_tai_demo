set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR cortex-m3)

if(DEFINED ENV{STM32_GNU_TOOLS_ROOT} AND NOT "$ENV{STM32_GNU_TOOLS_ROOT}" STREQUAL "")
    set(STM32_GNU_TOOLS_ROOT "$ENV{STM32_GNU_TOOLS_ROOT}")
else()
    set(STM32_GNU_TOOLS_ROOT "$ENV{HOME}/.local/share/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2")
endif()

set(_STM32_BIN "${STM32_GNU_TOOLS_ROOT}/bin")
set(CMAKE_C_COMPILER "${_STM32_BIN}/arm-none-eabi-gcc")
set(CMAKE_ASM_COMPILER "${_STM32_BIN}/arm-none-eabi-gcc")
set(CMAKE_OBJCOPY "${_STM32_BIN}/arm-none-eabi-objcopy")
set(CMAKE_SIZE "${_STM32_BIN}/arm-none-eabi-size")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
